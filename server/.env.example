# ─── Server ───────────────────────────────────────────────
PORT=3001

# Comma-separated list of allowed browser origins (the deployed client URL).
# Leave UNSET for local dev (allows all origins).
# Example: CLIENT_ORIGIN=https://pricing.example.com
CLIENT_ORIGIN=

# Long random string — generate with: openssl rand -base64 48
# The server refuses to start if this is empty.
JWT_SECRET=change_me_to_a_long_random_string

# ─── Database ─────────────────────────────────────────────
# Option A: a single connection string (most managed providers give you this).
# When set, it takes precedence over the DB_* fields below and enables SSL.
DATABASE_URL=

# Option B: individual fields (local dev).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kfg_project
DB_USER=postgres
DB_PASSWORD=your_password_here

# Set to "true" to force TLS when using the DB_* fields with a managed DB.
DB_SSL=false

# ─── Outgoing email ───────────────────────────────────────
# The mailbox every system notification is sent from. Leave SMTP_HOST empty to
# disable all outgoing email (including the route validity alerts).
SMTP_HOST=smtp.gmail.com
SMTP_USER=network@kfg.co.il
# Gmail requires a 16-character App Password, not the account password.
SMTP_PASSWORD=

# Optional — these are the built-in defaults.
SMTP_PORT=587
SMTP_SECURE=false

# From header on every notification. Defaults to "KFG NETWORK
# <network@kfg.co.il>". Most providers only deliver when the address matches
# SMTP_USER (or an alias it is allowed to send as); the display name is free text.
MAIL_FROM=KFG NETWORK <network@kfg.co.il>

# ─── Route validity alerts ────────────────────────────────
# One email per route when it is a week from expiring, a day from expiring, and
# once expired. Comma-separated; defaults to log.il@kfg.co.il.
ROUTE_ALERT_RECIPIENTS=log.il@kfg.co.il

# Hour (0-23) the daily check runs at, read in ROUTE_ALERT_TIMEZONE.
# The timezone is explicit because the production host runs in UTC.
ROUTE_ALERT_HOUR=8
ROUTE_ALERT_TIMEZONE=Asia/Jerusalem

# Public client URL, used for the "Open Route" link in the emails.
APP_URL=https://kfg.network

# ─── Client auto-refresh ──────────────────────────────────
# Every /api response carries an X-App-Version header; open tabs compare it and
# reload when it changes, so a new deployment reaches users who never closed the
# app. Tabs also re-check on focus and every 15 minutes as a fallback.
# Leave APP_VERSION empty to track deployments automatically (RENDER_GIT_COMMIT,
# falling back to the built index.html timestamp). Set it to any string and bump
# that string to push a refresh to every open tab without redeploying.
APP_VERSION=

# Set to "false" to switch the whole behaviour off.
CLIENT_AUTO_REFRESH=true
